{
  "name": "lumi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev":           "next dev",
    "build":         "next build",
    "start":         "next start",
    "typecheck":     "tsc --noEmit",
    "db:types":      "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > lib/database.types.ts",
    "author:draft":  "tsx scripts/author/draft-level.ts",
    "prerender":     "tsx scripts/prerender.ts",
    "prerender:dry": "tsx scripts/prerender.ts --dry"
  },
  "dependencies": {
    "next":                  "^15.0.0",
    "react":                 "^18.3.0",
    "react-dom":             "^18.3.0",
    "@supabase/supabase-js": "^2.48.0",
    "@supabase/ssr":         "^0.5.0",
    "stripe":                "^17.0.0",
    "resend":                "^4.0.0",
    "posthog-js":            "^1.157.0"
  },
  "devDependencies": {
    "@types/node":         "^20.0.0",
    "@types/react":        "^18.3.0",
    "@types/react-dom":    "^18.3.0",
    "typescript":          "^5.5.0",
    "tsx":                 "^4.19.0",
    "@anthropic-ai/sdk":   "^0.32.0",
    "tailwindcss":         "^3.4.0",
    "autoprefixer":        "^10.4.0",
    "postcss":             "^8.4.0",
    "supabase":            "^1.200.0"
  }
}

