{
  "framework": "nextjs",
  "functions": {
    "app/api/webhooks/stripe/route.ts": {
      "maxDuration": 30
    },
    "app/api/story/next/route.ts": {
      "maxDuration": 30
    },
    "app/api/preview/route.ts": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/webhooks/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
