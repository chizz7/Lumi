{
  "framework": "nextjs",
  "crons": [
    { "path": "/api/cron/deliver", "schedule": "0 16 * * *" }
  ],
  "functions": {
    "app/api/webhooks/stripe/route.ts": {
      "maxDuration": 30
    },
    "app/api/story/next/route.ts": {
      "maxDuration": 30
    },
    "app/api/cron/deliver/route.ts": {
      "maxDuration": 300
    },
    "app/api/preview/route.ts": {
      "maxDuration": 60
    },
    "app/api/preview/sample/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/webhooks/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
